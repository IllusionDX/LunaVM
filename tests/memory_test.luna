var start = clock()

var items = []
var i = 0
while i < 1000000:
    # Tests here:
    # 1. Method/function call (append)
    # 2. Memory allocation (Heap)
    # 3. ARC (the refcount of 'i' when entering the list)
    items.append(i)
    i = i + 1

var end = clock()
print(f"One million appends in: {end - start} seconds")