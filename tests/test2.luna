    "entities": {
        "wolf_alpha": {
            "hp": 500,
            "position": [120.5, 44.0],
            "tags": ["hostile", "elite", "boss"]
        },
        "drone_unit": {
            "hp": 50,
            "position": [10.0, 5.0],
            "tags": ["robotic", "scout"]
        }
