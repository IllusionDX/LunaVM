# Test closure with multiple captured variables

def make_adder(base):
    var offset = 10
    def adder(x):
        return base + x + offset
    return adder

var add5 = make_adder(5)
print(add5(3))

# Test nested closures

def outer():
    var x = 1
    def middle():
        var y = 2
        def inner():
            return x + y
        return inner
    return middle

var f = outer()
var g = f()
print(g())

# Test closure modifying captured variable

def make_accumulator():
    var total = 0
    def add(n):
        total = total + n
        return total
    return add

var acc = make_accumulator()
print(acc(5))
print(acc(10))
print(acc(3))
