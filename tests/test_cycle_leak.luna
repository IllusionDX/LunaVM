# Small scale sanity check first (consolidated from test_cycle_small.luna)
var i = 0
while i < 1000:
    var a = []
    var b = []
    a.append(b)
    b.append(a)
    i = i + 1
print("Done with list cycles")

var j = 0
while j < 1000:
    var d1 = {}
    var d2 = {}
    d1["other"] = d2
    d2["other"] = d1
    j = j + 1
print("Done with dict cycles")

# Large scale stress test
var start = clock()

i = 0
while i < 100000:
    var a = []
    var b = []
    a.append(b)
    b.append(a)
    i = i + 1

j = 0
while j < 100000:
    var d1 = {}
    var d2 = {}
    d1["other"] = d2
    d2["other"] = d1
    j = j + 1

var end = clock()
print(f"Created 200k cycles in: {end - start} seconds")
print("If the GC works, this program should not consume GBs of RAM")
