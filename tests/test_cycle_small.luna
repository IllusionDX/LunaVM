var start = clock()

# Test 1: Create a cycle using a list that contains itself
var i = 0
while i < 1000:
    var a = []
    var b = []
    a.append(b)
    b.append(a)
    i = i + 1

print("Done with list cycles")

# Test 2: Create a cycle using dictionaries
var j = 0
while j < 1000:
    var d1 = {}
    var d2 = {}
    d1["other"] = d2
    d2["other"] = d1
    j = j + 1

print("Done with dict cycles")

var end = clock()
print(f"Created 2k cycles in: {end - start} seconds")
