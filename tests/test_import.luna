# Test real module import

import math

print("add 3+5:")
print(math.add(3, 5))

print("pi:")
print(math.pi)

print("author:")
print(math.author)

# Test from import
from math import multiply, pi

print("multiply 4*7:")
print(multiply(4, 7))
print("pi from global:")
print(pi)

print("import test done")
