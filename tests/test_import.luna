# Test real module import with built-in math

import math

print("sin(0):")
print(math.sin(0))

print("cos(0):")
print(math.cos(0))

print("sqrt(16):")
print(math.sqrt(16))

print("pow(2, 8):")
print(math.pow(2, 8))

print("pi:")
print(math.pi)

print("e:")
print(math.e)

# Test from import
from math import sqrt, pi

print("sqrt from global:")
print(sqrt(25))
print("pi from global:")
print(pi)

# Test clamp and lerp
print("clamp(15, 0, 10):")
print(math.clamp(15, 0, 10))

print("lerp(0, 100, 0.5):")
print(math.lerp(0, 100, 0.5))

print("import test done")
