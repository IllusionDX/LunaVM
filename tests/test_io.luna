import os

var path = "tests/_io_tmp.txt"

# write_file / read_file / exists
os.write_file(path, "hello\nworld\n")
print(os.exists(path))

var read_back = os.read_file(path)
print(read_back == "hello\nworld\n")

# append_file
os.append_file(path, "appended")
var after_append = os.read_file(path)
print(after_append == "hello\nworld\nappended")

# open / read_line
var f = os.open(path, "r")
var line1 = f.read_line()
print(line1 == "hello")

var line2 = f.read_line()
print(line2 == "world")

var line3 = f.read_line()
print(line3 == "appended")

var line4 = f.read_line()
print(line4 == null)

f.close()

# open / read_all
var f2 = os.open(path, "r")
var all = f2.read_all()
print(all == "hello\nworld\nappended")
f2.close()

# open / write
var f3 = os.open(path, "w")
f3.write("abc")
f3.close()

var f4 = os.open(path, "r")
var w = f4.read_all()
print(w == "abc")
f4.close()

# remove
os.remove(path)
print(os.exists(path) == false)

# File constructor alias
var f5 = os.File(path, "w")
f5.write("from ctor")
f5.close()

var f6 = os.File(path, "r")
print(f6.read_all() == "from ctor")
f6.close()

os.remove(path)

# exists false
print(os.exists("tests/_nonexistent_file_xyz.luna") == false)
