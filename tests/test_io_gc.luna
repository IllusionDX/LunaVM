import os
var path = "tests/_io_gc_test.txt"
var f = os.File(path, "w")
f.write("gc test data")
f.close()
var content = os.read_file(path)
print(content == "gc test data")
print(os.remove(path))
print(os.exists(path) == false)
var p1 = "tests/_io_gc_1.txt"
var p2 = "tests/_io_gc_2.txt"
var f1 = os.File(p1, "w")
f1.write("file1")
f1.close()
var f2 = os.File(p2, "w")
f2.write("file2")
f2.close()
var c1 = os.read_file(p1)
var c2 = os.read_file(p2)
print(c1 == "file1")
print(c2 == "file2")
os.remove(p1)
os.remove(p2)
var f3 = os.File(path, "w")
f3.write("gc finalizer test data")
f3.flush()
var i = 0
while i < 2000:
    var _ = [i, i + 1]
    i = i + 1
var after_gc = os.read_file(path)
print(after_gc == "gc finalizer test data")
try:
    f3.close()
except:
    pass
os.remove(path)
var f4 = os.File(path, "w")
f4.write("before close")
f4.close()
try:
    f4.write("after close")
    print(false)
except:
    print(true)
os.remove(path)
