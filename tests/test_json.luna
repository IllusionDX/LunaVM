from json import JSON

# Parse tests

# Basic types
var basic = JSON.parse("{\"num\": 42, \"flt\": 3.14, \"str\": \"hello\", \"bool\": true, \"nil\": null}")
print(basic.num == 42)
print(basic.flt == 3.14)
print(basic.str == "hello")
print(basic.bool == true)
print(basic["nil"] == null)

# Array
var arr = JSON.parse("[1, 2, 3, \"four\", false, null]")
print(arr.length == 6)
print(arr[0] == 1)
print(arr[3] == "four")
print(arr[4] == false)
print(arr[5] == null)

# Nested
var nested = JSON.parse("{\"a\": {\"b\": [1, 2]}, \"c\": [3, 4]}")
print(nested.a.b[0] == 1)
print(nested.c[1] == 4)

# Empty structures
var empty_obj = JSON.parse("{}")
print(empty_obj.length() == 0)
var empty_arr = JSON.parse("[]")
print(empty_arr.length == 0)

# String escapes
var esc = JSON.parse("{\"s\": \"hello\\nworld\\ttab\"}")
print(esc.s == "hello\nworld\ttab")

# Large integer -> int64
var big = JSON.parse("{\"x\": 2147483648}")
print(big.x == 2147483648)

# Encode tests

# Roundtrip
var original = {"name": "Zim", "hp": 100, "active": true, "tags": ["fire", "ice"]}
var encoded = JSON.encode(original)
var decoded = JSON.parse(encoded)
print(decoded.name == "Zim")
print(decoded.hp == 100)
print(decoded.active == true)
print(decoded.tags[0] == "fire")

# Encode basic types
print(JSON.encode(42) == "42")
print(JSON.encode(true) == "true")
print(JSON.encode(null) == "null")

# Encode string
print(JSON.encode("hello") == "\"hello\"")

# Encode array
var list = [1, 2, 3]
print(JSON.encode(list) == "[1,2,3]")

# Encode empty
print(JSON.encode({}) == "{}")
print(JSON.encode([]) == "[]")

# Encode int64
var large = 2147483648
print(JSON.encode(large) == "2147483648")

# Encode with escapes
var with_newline = "hello\nworld"
print(JSON.encode(with_newline) == "\"hello\\nworld\"")
