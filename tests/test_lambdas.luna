# Test lambdas / arrow functions

var add = (a, b) => a + b
print(add(3, 4))

var square = (x) => x * x
print(square(5))

var noparams = () => 42
print(noparams())

# Higher-order function
var make_adder = (n) => (x) => x + n
var add5 = make_adder(5)
print(add5(10))

# Simple lambda usage
var apply = (f, v) => f(v)
print(apply((x) => x * 2, 7))

# Minimal lambda (regression)
var min = (a, b) => a + b
print(min(1, 2))
