import noise

# --- Callable 2D noise ---
var perlin = noise.Perlin(42)
var p1 = perlin(1.5, 2.5)
print(p1 >= 0.0 and p1 <= 1.0)

var simplex = noise.Simplex(42)
var s1 = simplex(1.5, 2.5)
print(s1 >= 0.0 and s1 <= 1.0)

var voronoi = noise.Voronoi(42, 2.0)
var v1 = voronoi(1.5, 2.5)
print(v1 >= 0.0 and v1 <= 1.0)

# --- Callable 3D noise (optional z) ---
var p3d = perlin(1.5, 2.5, 3.5)
print(p3d >= 0.0 and p3d <= 1.0)

var s3d = simplex(1.5, 2.5, 3.5)
print(s3d >= 0.0 and s3d <= 1.0)

var v3d = voronoi(1.5, 2.5, 3.5)
print(v3d >= 0.0 and v3d <= 1.0)

# --- Voronoi edge (2D and 3D) ---
var e2d = voronoi.edge(1.5, 2.5)
print(e2d >= 0.0 and e2d <= 1.0)

var e3d = voronoi.edge(1.5, 2.5, 3.5)
print(e3d >= 0.0 and e3d <= 1.0)

# --- Reproducibility: same seed gives same value ---
var perlin2 = noise.Perlin(42)
var p2 = perlin2(1.5, 2.5)
print(p1 == p2)

var simplex2 = noise.Simplex(42)
var s2 = simplex2(1.5, 2.5)
print(s1 == s2)

var voronoi2 = noise.Voronoi(42, 2.0)
var v2 = voronoi2(1.5, 2.5)
print(v1 == v2)

# --- Different seeds give different values ---
var perlin3 = noise.Perlin(99)
var p3 = perlin3(1.5, 2.5)
print(p1 != p3)

# --- Default seed (0) works ---
var perlin0 = noise.Perlin()
var p0 = perlin0(0.0, 0.0)
print(p0 >= 0.0 and p0 <= 1.0)

# --- Voronoi default cell_size ---
var voronoi_default = noise.Voronoi(123)
var vd = voronoi_default(3.0, 4.0)
print(vd >= 0.0 and vd <= 1.0)
