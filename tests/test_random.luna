import random

var rng = random.PCG(12345)

# int range
var r1 = rng.int(1, 100)
print(r1 >= 1 and r1 <= 100)

var r2 = rng.int(1, 100)
print(r2 >= 1 and r2 <= 100)

# float 0..1
var f1 = rng.float()
print(f1 >= 0.0 and f1 <= 1.0)

# float range
var f2 = rng.float(10.0, 20.0)
print(f2 >= 10.0 and f2 <= 20.0)

# reseed reproducibility
rng.seed(12345)
var r3 = rng.int(1, 100)
print(r3 == r1)

# two independent RNGs with same seed produce same sequence
var rng_a = random.PCG(42)
var rng_b = random.PCG(42)
print(rng_a.int(1, 100) == rng_b.int(1, 100))

# Xorshift also works
var xs = random.Xorshift(99)
var xs_val = xs.int(1, 10)
print(xs_val >= 1 and xs_val <= 10)

# rng.choice on list (uses seeded RNG, not C rand())
var items = ["apple", "banana", "cherry"]
var picked = rng.choice(items)
print(picked == "apple" or picked == "banana" or picked == "cherry")

# rng.choice on string
var letters = "abc"
var ch = rng.choice(letters)
print(ch == "a" or ch == "b" or ch == "c")

# Reproducibility: same seed gives same choice result
var rng2 = random.PCG(777)
var c1 = rng2.choice([10, 20, 30])
var rng3 = random.PCG(777)
var c2 = rng3.choice([10, 20, 30])
print(c1 == c2)

# rng.shuffle in-place
var deck = [1, 2, 3, 4, 5]
rng.shuffle(deck)
print(deck.length == 5)

# Reproducibility: same seed gives same shuffle
var rng4 = random.PCG(999)
var list1 = [10, 20, 30, 40]
rng4.shuffle(list1)

var rng5 = random.PCG(999)
var list2 = [10, 20, 30, 40]
rng5.shuffle(list2)

print(list1[0] == list2[0] and list1[1] == list2[1] and list1[2] == list2[2] and list1[3] == list2[3])
