a = [1, 2, 3, 4, 5]
print(a[1:3])
print(a[:3])
print(a[2:])
print(a[:])
print(a[::2])
print(a[::-1])
print(a[1:4:2])
print(a[-2:])
print(a[:-2])
print(a[::-2])

s = "hello"
print(s[1:4])
print(s[::-1])
print(s[::2])

var t = "Héroe"
print(t[::-1] == "eoréH")
print(t[1:4] == "éro")
print(t[:2] == "Hé")
