# Test try/except/throw with nested exceptions

try:
    throw("error")
except as e:
    print("caught:")
    print(e)

print("after try/except")

# Nested try/except
try:
    try:
        throw("inner")
    except as inner:
        print("inner caught:")
        print(inner)
        throw("rethrown")
except as outer:
    print("outer caught:")
    print(outer)
