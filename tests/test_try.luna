# Test try/catch/throw with nested exceptions

try:
    throw("error")
catch e:
    print("caught:")
    print(e)

print("after try/catch")

# Nested try/catch
try:
    try:
        throw("inner")
    catch inner:
        print("inner caught:")
        print(inner)
        throw("rethrown")
catch outer:
    print("outer caught:")
    print(outer)
